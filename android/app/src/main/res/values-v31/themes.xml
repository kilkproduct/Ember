<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a splash before the activity window exists. Match it
         to the app so the first frame is Ember, not a white flash. -->
    <style name="Theme.Ember" parent="@style/BaseThemeEmber">
        <item name="android:windowSplashScreenBackground">@color/ember_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
